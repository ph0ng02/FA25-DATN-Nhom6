  m_Script: {fileID: 11500000, guid: f32ce42e98682af4fb06ac41ef722b88, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogueTrigger
  npcName: NPC
  dialogueLines:
  - "Nh\xECn c\xE1i c\xE1ch c\u1EADu c\u1EA7m ki\u1EBFm l\xE0 bi\u1EBFt t\u1EEBng
    qua chi\u1EBFn tr\u01B0\u1EDDng r\u1ED3i"
  - "\u1EDE v\xF9ng n\xE0y, l\u0169 th\xFA \u0111\xE3 b\u1ECB H\u01B0 Kh\xF4ng l\xE0m
    cho h\xF3a \u0111i\xEAn. C\u1EA9n th\u1EADn \u0111\u1EA5y\r\n"
  - "N\u1EBFu anh mu\u1ED1n tr\u1EA3 th\xF9 Arkanos, t\xF4i s\u1EBD ch\u1EC9 \u0111\u01B0\u1EDDng\r\n\r\n"
  - "Nh\u01B0ng tr\u01B0\u1EDBc h\u1EBFt gi\xFAp t\xF4i gi\u1EBFt h\u1EBFt nh\u1EEFng
    t\xEAn qu\xE1i v\u1EADt \u1EDF \u0111\xE2y \u0111\xE3\r\n\r\n"
  - "Ch\xFAng \u0111ang tr\xEAn \u0111\u01B0\u1EDDng t\xECm v\xE0 ph\xE1 h\u1EE7y
    ng\xF4i l\xE0ng c\u1EE7a t\xF4i\r\n\r\n"
  dialogueUI: {fileID: 7859721982331633541}
  dialogueText: {fileID: 8597551556406827708}
