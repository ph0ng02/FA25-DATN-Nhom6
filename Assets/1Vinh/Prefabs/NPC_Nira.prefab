--- !u!114 &6307017037783647087
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3279924346266881538}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5e2abebdfb4949b499ce7e3ba52be109, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueQuestNPC
  dialogueLines:
  - "\"Ng\u01B0\u01A1i...kh\xF4ng ph\u1EA3i ng\u01B0\u1EDDi c\u1EE7a th\xE0nh ph\u1ED1
    n\xE0y. Ng\u01B0\u01A1i \u0111\u1EBFn t\u1EEB b\xEAn kia khe n\u1EE9t \u0111\xFAng
    ch\u1EE9?\""
  - "\"C\xF4 l\xE0 ai? V\xE0 chuy\u1EC7n g\xEC \u0111\xE3 x\u1EA3y ra v\u1EDBi n\u01A1i
    n\xE0y v\u1EADy?\""
  - "\"Ta l\xE0 Nira, l\xE0 ng\u01B0\u1EDDi may m\u1EAFn s\u1ED1ng s\xF3t qua cu\u1ED9c
    x\xE2m chi\u1EBFm \u0111\u1EA7u ti\xEAn c\u1EE7a t\xEAn Akanos. N\u01A1i \u0111\xE2y
    tr\u01B0\u1EDBc t\u1EEBng l\xE0 nh\xE0 c\u1EE7a gia t\u1ED9c ta cho \u0111\u1EBFn
    khi h\u1EAFn \u0111\u1EBFn \u0111\xE2y chi\u1EBFm l\u1EA5y nh\xE0 c\u1EE7a ta
    v\xE0 m\u1EDF c\xE1nh c\u1ED5ng h\u01B0 kh\xF4ng \u0111\u1EA7u ti\xEAn.\""
  - "\"C\xE1c chi\u1EBFn binh v\xEC b\u1EA3o v\u1EC7 gia t\u1ED9c ta \u0111\u1EC1u
    \u0111\xE3 b\u1ECB t\xEAn Akanos ti\xEAu di\u1EC7t v\xE0 ph\xE1 s\u1EADp l\xE2u
    \u0111\xE0i bi\u1EBFn t\u1EA5t c\u1EA3 th\xE0nh tro b\u1EE5i.\""
  - "\"M\xE0 t\u1EA1i sao ng\u01B0\u01A1i l\u1EA1i xu\u1EA5t hi\u1EC7n \u1EDF \u0111\xE2y?\nKh\xF4ng
    l\u1EBD \u0111\u1EA5t n\u01B0\u1EDBc c\u1EE7a ng\u01B0\u01A1i c\u0169ng b\u1ECB
    h\u1EAFn chi\u1EBFm \u01B0?\""
  - "\"\u0110\xFAng v\u1EADy. H\u1EAFn \u0111\xE3 xuy\xEAn qua m\u1ED9t khe n\u1EE9t
    v\xE0 h\xFAt t\u1EA5t c\u1EA3 binh l\xEDnh v\xE0o \u0111\xE2y. B\xE2y gi\u1EDD
    t\xF4i \u0111ang mu\u1ED1n t\xECm \u0111\u01B0\u1EDDng \u0111i \u0111\u1EBFn
    ch\u1ED7 h\u1EAFn \u0111\u1EC3 ti\xEAu   di\u1EC7t h\u1EAFn. C\xF4 c\xF3 th\u1EC3
    gi\xFAp t\xF4i \u0111\u01B0\u1EE3c kh\xF4ng.\""
  - "\"\u0110\u01B0\u1EE3c th\xF4i nh\u01B0ng gi\xFAp ta 2 vi\u1EC7c \u0111\u01B0\u1EE3c
    kh\xF4ng?\nTa c\u1EA3m nh\u1EADn \u0111\u01B0\u1EE3c m\u1ED9t tia s\xE1ng nh\u1ECF
    \u1EDF g\u1EA7n d\xF2ng su\u1ED1i.\nTa c\xF3 th\u1EC3 h\u1EA5p th\u1EE5 nh\u1EEFng
    n\u0103ng l\u01B0\u1EE3ng t\u1EEB tia s\xE1ng \u0111\xF3.\nC\xF3 th\u1EC3 n\xF3
    s\u1EBD gi\xFAp \u0111\u01B0\u1EE3c chung ta hi\u1EC3u ra \u0111\u01B0\u1EE3c
    g\xEC \u0111\xF3.\""
  speakerLines:
  - Nira
  - Kael
  - Nira
  - Nira
  - Nira
  - Kael
  - Nira
