  m_Script: {fileID: 11500000, guid: f32ce42e98682af4fb06ac41ef722b88, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogueTrigger
  npcName: NPC
  dialogueLines:
  - "\"\u0110\xF3m l\u1EEDa n\xE0y l\xE0 g\xEC v\u1EADy? Sao l\u1EA1i b\xE1m theo
    m\xECnh.\""
  - "\"C\xF4 c\u0169ng b\u1ECB t\xEAn Akanos h\xFAt v\xE0o \u0111\xE2y sao?\""
  - "\"Ng\u01B0\u01A1i bi\u1EBFt h\u1EAFn \u01B0? Ng\u01B0\u01A1i l\xE0 ai?\""
  - "\"Ta c\u0169ng t\u1EEBng l\xE0 m\u1ED9t chi\u1EBFn binh b\u1ECB t\xEAn Akanos
    x\xE2m chi\u1EBFm \u0111\u1EA5t n\u01B0\u1EDBc v\xE0 h\xFAt v\xE0o \u0111\xE2y,
    nh\u01B0ng ta kh\xF4ng \u0111\u1EE7 s\u1EE9c m\u1EA1nh \u0111\u1EC3 \u0111\xE1nh
    b\u1EA1i h\u1EAFn v\xE0 tho\xE1t kh\u1ECFi \u0111\xE2y n\xEAn b\xE2y gi\u1EDD
    ta b\u1ECB m\u1EAFc k\u1EB9t \u1EDF d\u1EA1ng linh h\u1ED3n \u1EDF \u0111\xE2y.\""
  - "\"V\xE2y ng\u01B0\u01A1i bi\u1EBFt t\xEAn Akanos \u1EDF \u0111\xE2u ch\u1EE9?
    C\xF3 th\u1EC3 ch\u1EC9 \u0111\u01B0\u1EDDng ta \u0111\u1EBFn \u0111\xF3 kh\xF4ng?\""
  - "\"\u0110\u01B0\u1EE3c th\xF4i, ta s\u1EBD \u0111i c\xF9ng v\xE0 ch\u1EC9 \u0111\u01B0\u1EDDng
    c\xF4 \u0111\u1EBFn \u0111\xF3.\""
