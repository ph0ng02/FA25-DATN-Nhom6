    - target: {fileID: 3610753184720269686, guid: 3357b2d8b9acaf640bf0107242fc597d, type: 3}
      propertyPath: 'dialogueLines.Array.data[1]'
      value: "\"C\xF4 l\xE0 ai? \u0110\xE2y l\xE0 n\u01A1i n\xE0o?\""
      objectReference: {fileID: 0}
    - target: {fileID: 3610753184720269686, guid: 3357b2d8b9acaf640bf0107242fc597d, type: 3}
      propertyPath: 'dialogueLines.Array.data[2]'
      value: "\"\u0110\xE2y l\xE0 Riftlands \u2013 v\xF9ng \u0111\u1EA5t b\u1ECB
        nu\u1ED1t ch\u1EEDng b\u1EDFi H\u01B0 Kh\xF4ng. V\xE0 k\u1EBB \u0111\xE3
        \u0111\u01B0a ng\u01B0\u01A1i t\u1EDBi \u0111\xE2y\u2026 ch\u1EB3ng ai kh\xE1c
        ngo\xE0i Arkanos.\""
