      propertyPath: 'dialogueLines.Array.data[0]'
      value: "\"Ng\u01B0\u1EDDi l\u1EA1\u2026 ta c\u1EA3m nh\u1EADn \u0111\u01B0\u1EE3c
        s\u1EE9c m\u1EA1nh c\u1EE7a m\u1ED9t chi\u1EBFn binh t\u1EEB th\u1EBF gi\u1EDBi
