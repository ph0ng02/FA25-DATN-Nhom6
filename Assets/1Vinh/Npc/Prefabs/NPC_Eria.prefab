  m_Script: {fileID: 11500000, guid: f32ce42e98682af4fb06ac41ef722b88, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogueTrigger
  npcName: NPC
  dialogueLines:
  - "\"Ng\u01B0\u1EDDi l\u1EA1\u2026 ta c\u1EA3m nh\u1EADn \u0111\u01B0\u1EE3c s\u1EE9c
    m\u1EA1nh c\u1EE7a m\u1ED9t chi\u1EBFn binh t\u1EEB th\u1EBF gi\u1EDBi kh\xE1c.\""
  - "\"C\xF4 l\xE0 ai? \u0110\xE2y l\xE0 n\u01A1i n\xE0o?\""
  - "\"\u0110\xE2y l\xE0 Riftlands \u2013 v\xF9ng \u0111\u1EA5t b\u1ECB nu\u1ED1t
    ch\u1EEDng b\u1EDFi H\u01B0 Kh\xF4ng. V\xE0 k\u1EBB \u0111\xE3 \u0111\u01B0a
    ng\u01B0\u01A1i t\u1EDBi \u0111\xE2y\u2026 ch\u1EB3ng ai kh\xE1c ngo\xE0i Arkanos.\""
  - "\"V\u1EADy th\xEC ta s\u1EBD t\xECm h\u1EAFn\u2026 v\xE0 k\u1EBFt th\xFAc chuy\u1EC7n
    n\xE0y \u0111\u1EC3 c\u1EE9u \u0111\u1EA5t n\u01B0\u1EDBc c\u1EE7a ta.\""
  - "\"\u0110\u01B0\u1EE3c th\xF4i, Nh\u01B0ng tr\u01B0\u1EDBc h\u1EBFt h\xE3y ch\u1EA1y
    kh\u1ECFi khu v\u1EF1c c\xF4 \u0111ang \u0111\u1EE9ng \u0111\xE3 v\xEC s\u1EAFp
    c\xF3 m\u1ED9t l\xE0n kh\xF3i \u0111\u1ED9c bay l\xEAn \u0111\u1EA5y.\""
  speakerLines:
  - Eria
  - Kael
  - Eria
  - Kael
  - Eria
  dialogueUI: {fileID: 8316131191520085589}
  dialogueText: {fileID: 3011269754463201863}
