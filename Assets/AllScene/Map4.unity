--- !u!114 &825652671
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 825652668}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5e2abebdfb4949b499ce7e3ba52be109, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueQuestNPC
  dialogueLines:
  - "\"H\u1EEBm\u2026 thanh ki\u1EBFm c\u1EE7a c\xF4 \u0111\xE3 th\u1EA5y nhi\u1EC1u
    tr\u1EADn chi\u1EBFn r\u1ED3i.\" "
  - "\"\xD4ng l\xE0 ai?\""
  - "\"Ta l\xE0 m\u1ED9t th\u1EE3 r\xE8n kh\xF4ng may \u0111i ngang qua ch\u1ED7
    c\u1EE7a t\xEAn Akanos n\xEAn c\u0169ng b\u1ECB h\xFAt v\xE0o trong \u0110\xE2y.\""
  - "\"Ta c\xF3 th\u1EC3 c\u01B0\u1EDDng h\xF3a n\xF3 v\xE0 h\u01B0\u1EDBng d\u1EABn
    c\xF4 \u0111\u1EBFn ch\u1ED7 c\u1EE7a h\u1EAFn, nh\u01B0ng c\xF4 ph\u1EA3i gi\xFAp
    ta t\xECm l\u1EA1i b\xFAa r\xE8n \u0111\xE3.\""
  - "\"Sao \xF4ng bi\u1EBFt t\xF4i \u0111\u1EBFn t\xECm h\u1EAFn?\""
  - "\"Ta \u0111o\xE1n v\u1EADy th\xF4i v\xEC ta ch\u01B0a g\u1EB7p m\u1ED9t chi\u1EBFn
    binh n\xE0o qua \u0111\xE2y c\u1EA3 c\xF4 l\xE0 chi\u1EBFn binh \u0111\u1EA7u
    ti\xEAn \u0111\u1EBFn \u0111\xE2y.\""
  - "\"V\u1EADy t\xF4i s\u1EBD gi\xFAp \xF4ng t\xECm l\u1EA1i b\xFAa r\xE8n \xF4ng
    h\xE3y ch\u1EC9 t\xF4i \u0111\u1EBFn ch\u1ED7 h\u1EAFn \u0111\u01B0\u1EE3c kh\xF4ng?\""
  - "\"T\u1EA5t nhi\xEAn l\xE0 \u0111\u01B0\u1EE3c r\u1ED3i\""
  speakerLines:
  - Torren
  - Kael
  - Torren
  - Torren
  - Kael
  - Torren
  - Kael
  - Torren
  postQuestDialogue:
  - "\"C\u1EA3m \u01A1n c\xF4 \u0111\xE3 t\xECm l\u1EA1i \u0111\u01B0\u1EE3c c\xE2y
    b\xFAa r\xE8n cho ta.\n\u0110\u1EC3 ta gi\xFAp c\xF4 r\xE8n thanh ki\u1EBFm s\u1EAFt
    b\xE9n h\u01A1n.\""
  - "\"B\xE2y gi\u1EDD c\xF4 ch\u1EC9 c\u1EA7n ch\u1EA1y h\u01B0\u1EDBng v\u1EC1
    ph\xEDa b\xEAn ph\u1EA3i s\u1EBD c\xF3 m\u1ED9t c\u1ED5ng d\u1ECBch chuy\u1EC3n
    n\xF3 s\u1EBD d\u1ECBch chuy\u1EC3n c\xF4 t\u1EDBi ch\u1ED7 l\xE2u \u0111\xE0i
    c\u1EE7a t\xEAn Akanos.\""
  postQuestSpeaker:
  - Torren
  - Torren
  quest:
    questName: "T\xECm l\u1EA1i b\xFAa r\xE8n cho Torren"
    description: "\u0110i t\xECm b\xFAa r\xE8n v\xE0 \u0111em v\u1EC1 cho Torren"
