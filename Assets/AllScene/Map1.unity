      value: Kael
      objectReference: {fileID: 0}
    - target: {fileID: 7602717141132632255, guid: ee330022feba12243a37f96de06d1d6a, type: 3}
      propertyPath: 'speakerLines.Array.data[5]'
      value: Eria
      objectReference: {fileID: 0}
    - target: {fileID: 7602717141132632255, guid: ee330022feba12243a37f96de06d1d6a, type: 3}
      propertyPath: 'speakerLines.Array.data[6]'
      value: Kael
      objectReference: {fileID: 0}
    - target: {fileID: 7602717141132632255, guid: ee330022feba12243a37f96de06d1d6a, type: 3}
      propertyPath: 'speakerLines.Array.data[7]'
      value: Eria
      objectReference: {fileID: 0}
    - target: {fileID: 7602717141132632255, guid: ee330022feba12243a37f96de06d1d6a, type: 3}
      propertyPath: 'speakerLines.Array.data[8]'
      value: Eria
      objectReference: {fileID: 0}
    - target: {fileID: 7602717141132632255, guid: ee330022feba12243a37f96de06d1d6a, type: 3}
      propertyPath: 'dialogueLines.Array.data[0]'
      value: "\"Ng\u01B0\u01A1i l\xE0 h\u1ED3n ma xu\u1EA5t hi\u1EC7n \u1EDF v\xF9ng
        \u0111\u1EA5t b\u1ED1c kh\xED \u0111\u1ED9c h\u1ED3i n\xE3y ph\u1EA3i kh\xF4ng?\""
      objectReference: {fileID: 0}
    - target: {fileID: 7602717141132632255, guid: ee330022feba12243a37f96de06d1d6a, type: 3}
      propertyPath: 'dialogueLines.Array.data[1]'
      value: "\"\u0110\xFAng v\u1EADy.\""
      objectReference: {fileID: 0}
    - target: {fileID: 7602717141132632255, guid: ee330022feba12243a37f96de06d1d6a, type: 3}
      propertyPath: 'dialogueLines.Array.data[2]'
      value: "\"v\u1EADy ng\u01B0\u01A1i l\xE0 ai? T\u1EA1i sao l\u1EA1i \u1EDF \u0111\xE2y.\""
      objectReference: {fileID: 0}
    - target: {fileID: 7602717141132632255, guid: ee330022feba12243a37f96de06d1d6a, type: 3}
      propertyPath: 'dialogueLines.Array.data[3]'
      value: "\"Ta t\xEAn l\xE0 Eria. L\xE0 m\u1ED9t ph\xE1p s\u01B0 b\u1ECB  Akanos
        x\xE2m chi\u1EBFm \u0111\u1EA5t n\u01B0\u1EDBc v\xE0 ta c\u0169ng b\u1ECB
        h\u1EAFn h\xFAt \u0111\u1EBFn \u0111\xE2y v\xE0 b\u1ECB thu\u1ED9c h\u1EA1
        c\u1EE7a h\u1EAFn gi\u1EBFt. \""
      objectReference: {fileID: 0}
    - target: {fileID: 7602717141132632255, guid: ee330022feba12243a37f96de06d1d6a, type: 3}
      propertyPath: 'dialogueLines.Array.data[4]'
      value: "\"V\u1EADy c\xF4 c\xF3 bi\u1EBFt t\u1EA1i sao \u1EDF \u0111\xE2y l\u1EA1i
        xu\u1EA5t hi\u1EC7n nhi\u1EC1u qu\xE1i v\u1EADt v\u1EADy kh\xF4ng?\""
      objectReference: {fileID: 0}
    - target: {fileID: 7602717141132632255, guid: ee330022feba12243a37f96de06d1d6a, type: 3}
      propertyPath: 'dialogueLines.Array.data[5]'
      value: "\"L\xE0 do v\u1EBFt n\u1EE9t h\u01B0 kh\xF4ng c\u1EE7a t\xEAn Akanos
        t\u1EA1o ra c\xE1c con qu\xE1i v\u1EADt d\u1ECB d\u1EA1ng \u0111\xF3.\""
      objectReference: {fileID: 0}
    - target: {fileID: 7602717141132632255, guid: ee330022feba12243a37f96de06d1d6a, type: 3}
      propertyPath: 'dialogueLines.Array.data[6]'
      value: "\"C\xF4 c\xF3 th\u1EC3 chi t\xF4i \u0111\u01B0\u1EDDng \u0111i d\u1EBFn
        ch\u1ED7 c\u1EE7a h\u1EAFn \u0111\u01B0\u1EE3c kh\xF4ng?\nT\xF4i ph\u1EA3i
        gi\u1EBFt h\u1EAFn v\xE0 c\u1EE9u \u0111\u1EA5t n\u01B0\u1EDBc c\u1EE7a t\xF4i.\""
      objectReference: {fileID: 0}
    - target: {fileID: 7602717141132632255, guid: ee330022feba12243a37f96de06d1d6a, type: 3}
      propertyPath: 'dialogueLines.Array.data[7]'
      value: "\"\u0110\u01B0\u1EE3c th\xF4i.\nB\xE2y gi\u1EDD c\xF4 h\xE3y \u0111i
        t\u1EDBi cu\u1ED1i \u0111\u01B0\u1EDDng nh\xECn qua h\u01B0\u1EDBn b\xEAn
        tr\xE1i s\u1EBD th\u1EA5y c\xF3 m\u1ED9t m\xEA cung h\xE3y v\u01B0\u1EE3t
        qua m\xEA cung \u0111\xF3 c\xF4 s\u1EBD g\u1EB7p \u0111\u01B0\u1EE3c m\u1ED9t
        ng\u01B0\u1EDDi l\xE0 Lorin.\nNg\u01B0\u1EDDi \u1EA5y s\u1EBD ch\u1EC9 \u0111\u01B0\u1EDDng
