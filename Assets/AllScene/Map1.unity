--- !u!114 &1087887449
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1087887442}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5e2abebdfb4949b499ce7e3ba52be109, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueQuestNPC
  dialogueLines:
  - "\"C\xF4 l\xE0 Lorin ph\u1EA3i kh\xF4ng?\""
  - "\"Sao c\xF4 bi\u1EBFt t\xEAn c\u1EE7a t\xF4i?\""
  - "\"C\xF3 m\u1ED9t h\u1ED3n ma ph\xE1p s\u01B0 \u0111\xE3 n\xF3i cho t\xF4i chuy\u1EC7n
    \u0111\xF3.\nC\xF4 \u1EA5y ch\u1EC9 t\xF4i \u0111\u1EBFn g\u1EB7p c\xF4 v\xE0
    n\xF3i c\xF4 s\u1EBD ch\u1EC9 d\u1EABn t\xF4i \u0111\u1EBFn ch\u1ED7 c\u1EE7a
    t\xEAn Akanos.\""
  - "\"Ho\xE1 ra l\xE0 c\xF4 \u1EA5y.\nNh\xECn c\xE1ch c\xF4 c\u1EA7m ki\u1EBFm l\xE0
    bi\u1EBFt c\xF4 t\u1EEBng tr\u1EA3i qua c\xE1c chi\u1EBFn tr\u01B0\u1EDDng r\u1ED3i.
    \""
  - "\"\u1EDE \u0111\xE2y l\u0169 qu\xE1i \u0111\xE3 b\u1ECB s\u1EE9c m\u1EA1nh h\u01B0 
    kh\xF4ng l\xE0m cho ho\xE1 \u0111i\xEAn r\u1ED3i. C\xF4 h\xE3y c\u1EA9n th\u1EADn
    \u0111\u1EA5y.\""
  - "\"T\xF4i c\xF3 nghe Eria n\xF3i v\u1EC1 l\u0169 qu\xE1i n\xE0y r\u1ED3i. T\xF4i
    s\u1EBD ti\xEAu di\u1EC7t h\u1EBFt b\u1ECDn ch\xFAng v\xE0 \u0111\xE1nh b\u1EA1i
    t\xEAn Akanos \u0111\xF3.\""
  - "\"\u0110\u01B0\u1EE3c th\xF4i t\xF4i s\u1EBD ch\u1EC9 \u0111\u01B0\u1EDDng cho
    c\xF4\nNh\u01B0ng b\xE2y gi\u1EDD c\xF4 gi\xFAp t\xF4i m\u1ED9t chuy\u1EC7n \u0111\u01B0\u1EE3c
    kh\xF4ng?\""
  - "\"B\u1ECDn qu\xE1i v\u1EADt \u0111ang tr\xEAn \u0111\u01B0\u1EDDng \u0111\u1EBFn
    ng\xF4i l\xE0ng nh\u1ECF c\u1EE7a t\xF4i \u0111\u1EC3 ph\xE1 ho\u1EA1i. H\xE3y
    gi\xFAp t\xF4i ti\xEAu di\u1EC7t b\u1ECDn ch\xFAng.\""
  - "\"\u0110\u01B0\u1EE3c th\xF4i. T\xF4i s\u1EBD gi\xFAp c\xF4\""
  speakerLines:
  - Kael
  - Lorin
  - Kael
  - Lorin
  - Lorin
  - Kael
  - Lorin
  - Lorin
  - Kael
  postQuestDialogue: []
  postQuestSpeaker: []
  quest:
    questName: "Gi\xFAp Lorin Ti\xEAu di\u1EC7t qu\xE1i v\u1EADt \u0111ang \u0111\u1EBFn
      l\xE0ng"
    description: "Ti\xEAu di\u1EC7t 15 con qu\xE1i v\u1EADt"
    questType: 0
    isAccepted: 0
